{
	"appId": "com.liveconnect.app",
	"appName": "LiveConnect",
	"webDir": "dist",
	"server": {
		"androidScheme": "https",
		"cleartext": true
	},
	"plugins": {
		"CapacitorHttp": {
			"enabled": true
		}
	},
	"android": {
		"allowMixedContent": true,
		"captureInput": true,
		"webContentsDebuggingEnabled": false
	}
}
